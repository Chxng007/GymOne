# Copia a .env. Vite expone toda variable VITE_* al bundle del navegador —
# nunca pongas un secreto aquí.
VITE_API_URL=http://localhost:8080/api

# El acceso de invitado ya no se configura aquí: lo emite el backend en
# POST /api/auth/demo y se controla con DEMO_ENABLED en el entorno del backend.
# Así ninguna contraseña real acaba dentro del bundle del navegador.
