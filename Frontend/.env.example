# Copia a .env. Vite expone toda variable VITE_* al bundle del navegador —
# nunca pongas un secreto aquí.
VITE_API_URL=http://localhost:8080/api

# Acceso de demostración: si ambas están definidas, el login muestra un botón
# "Entrar como demo" que entra con esta cuenta. Quedan visibles en el bundle,
# así que usá una cuenta de demo desechable, nunca la del gimnasio real.
# Dejalas vacías o borralas para ocultar el botón.
VITE_DEMO_EMAIL=
VITE_DEMO_PASSWORD=
