# Copia a .env y rellena. Nunca subas .env al repositorio.
# Datasource — los valores por defecto coinciden con compose.yaml.
DB_URL=jdbc:postgresql://localhost:5434/gymone_db
DB_USERNAME=gymone
DB_PASSWORD=gymone

# --- Supabase como base de datos (alternativa a compose.yaml) ---
# Sacá la cadena del panel: Project Settings > Database > Connection string.
# Usá el pooler en modo SESSION (puerto 5432), no el de transacción (6543):
# Hibernate y HikariCP dependen de sentencias preparadas, que el modo de
# transacción no mantiene entre consultas.
# El usuario del pooler lleva la referencia del proyecto incorporada.
#
#   DB_URL=jdbc:postgresql://aws-0-<region>.pooler.supabase.com:5432/postgres
#   DB_USERNAME=postgres.<project-ref>
#   DB_PASSWORD=<la que definiste al crear el proyecto>
#
# La conexión directa (db.<project-ref>.supabase.co) es solo IPv6 y falla en
# hosts sin salida IPv6. Ante la duda, usá el pooler.
# Con ddl-auto=update, Hibernate crea las tablas solo en el esquema public.

# OBLIGATORIO, sin valor por defecto. Codificado en base64, mínimo 32 bytes (256 bits).
# Genera uno con:  openssl rand -base64 48
JWT_SECRET=
JWT_EXPIRATION_MS=86400000

# OBLIGATORIO, sin valor por defecto. Se usa una sola vez, cuando la tabla usuarios está vacía.
ADMIN_EMAIL=admin@gymone.local
ADMIN_PASSWORD=

# Opcional — correo saliente para las confirmaciones de pago.
MAIL_HOST=smtp.gmail.com
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=

# Opcional — el asistente de la aplicación queda desactivado sin esta clave.
GEMINI_API_KEY=
